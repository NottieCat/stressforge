# --- API ---
PORT=3000
# Allowed browser origin for the frontend. Leave unset for local dev (reflects
# any origin). Pin to e.g. http://localhost:3001 in production.
CORS_ORIGIN=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Queue ---
QUEUE_NAME=stressforge-executions
WORKER_CONCURRENCY=4

# --- Sandbox / execution limits ---
SANDBOX_IMAGE=stressforge-sandbox:latest
# Hard wall-clock ceiling (ms) for a single test-case run inside the container.
RUN_TIMEOUT_MS=2000
# Compilation ceiling (ms).
COMPILE_TIMEOUT_MS=30000
# Memory cap enforced via cgroups (Docker --memory).
MEMORY_LIMIT=256m
# CPU cap enforced via cgroups (Docker --cpus).
CPU_LIMIT=1.0
# Max stdout bytes captured per run (guards against fork-bomb-style output).
MAX_OUTPUT_BYTES=1048576
# Number of test cases the generator produces per submission.
TEST_CASE_COUNT=25

# --- Auto-Parser LLM (POST /generate-script) ---
# OpenAI-compatible. Leave OPENAI_API_KEY empty to disable the Auto-Parser
# gracefully (the endpoint returns 503; the server still boots and runs).
# Point OPENAI_BASE_URL at any OpenAI-compatible provider; leave unset for OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Wall-clock ceiling (ms) for fetching the problem page.
SCRAPE_TIMEOUT_MS=10000
